package jogo;

import java.io.Serializable;
import java.util.Random;

public class Mapa implements Serializable {
    private final int LINHAS = 10;
    private final int COLUNAS = 16;
    private char[][] mapa;

    public Mapa() {
        mapa = new char[LINHAS][COLUNAS];
        for (int i = 0; i < LINHAS; i++) {
            for (int j = 0; j < COLUNAS; j++) {
                mapa[i][j] = 'O'; // oculto inicialmente
            }
        }
    }

    public void exibir() {
        for (int i = 0; i < LINHAS; i++) {
            for (int j = 0; j < COLUNAS; j++) {
                System.out.print(mapa[i][j] + " ");
            }
            System.out.println();
        }
    }

    public void gerarEmbarcacoes() {
        // Simplificado: marca 70% como 'V' e preenche 30% com 'E' embarcação genérica
        int total = LINHAS * COLUNAS;
        int vazios = (int)(total * 0.7);
        int embarcacoes = total - vazios;

        // Preenche com 'V' (vazio)
        int count = 0;
        for (int i = 0; i < LINHAS; i++) {
            for (int j = 0; j < COLUNAS; j++) {
                if (count < vazios)
                    mapa[i][j] = 'V';
                else
                    mapa[i][j] = 'E'; // embarcação genérica só para teste
                count++;
            }
        }
        // Pode embaralhar mapa para distribuir embarcações aleatoriamente
    }

    public char receberAtaque(int x, int y) {
        if (x < 0 || x >= LINHAS || y < 0 || y >= COLUNAS)
            return '-';
        if (mapa[x][y] == 'E') {
            mapa[x][y] = 'X'; // Acertou embarcação
            return 'E';
        } else if (mapa[x][y] == 'V' || mapa[x][y] == 'O') {
            mapa[x][y] = 'Y'; // Errou
            return '-';
        }
        return '-';
    }

    public void atualizarAtaque(int x, int y, char simbolo) {
        if (x >= 0 && x < LINHAS && y >= 0 && y < COLUNAS)
            mapa[x][y] = simbolo;
    }
}
